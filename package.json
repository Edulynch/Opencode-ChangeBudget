{
  "name": "changebudget-cli",
  "version": "1.2.1",
  "private": true,
  "description": "Local change contract lifecycle CLI for ChangeBudget",
  "keywords": [
    "ai-coding",
    "change-management",
    "cli",
    "opencode",
    "scope-control"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Edulynch/Opencode-ChangeBudget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edulynch/Opencode-ChangeBudget.git"
  },
  "bugs": {
    "url": "https://github.com/Edulynch/Opencode-ChangeBudget/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "changebudget": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p opencode-plugin/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p opencode-plugin/tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.js\"",
    "ci:release-gate": "node scripts/validate-release.mjs --ci-safe",
    "smoke:tagged": "node scripts/smoke-tagged-install.mjs",
    "start": "node dist/src/cli/index.js"
  },
  "files": [
    "dist/src/**",
    "opencode-plugin/dist/opencode-plugin/**"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
